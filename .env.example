# Pollinations legacy (Classic) API — no key needed, rate limited per IP
POLLINATIONS_TEXT_BASE=https://text.pollinations.ai
POLLINATIONS_IMAGE_BASE=https://image.pollinations.ai
POLLINATIONS_MODEL=openai-fast

# Minimum gap between two text calls, in ms (Classic API: ~3s per IP)
POLLINATIONS_MIN_INTERVAL_MS=4000

# Path to a Chromium/Chrome binary. Leave empty to use Playwright's own build.
CHROMIUM_PATH=

# Set to 1 to watch the browser work
HEADFUL=0

PORT=5173
